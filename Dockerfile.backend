# Multi-stage Dockerfile for NeuroGraph-ASD FastAPI Backend
# We use Python 3.11 slim image for a lightweight container footprint.
FROM python:3.11-slim as base

# Set working directory inside the container
WORKDIR /app

# Set environment variables to prevent Python from writing .pyc files
# and to ensure stdout/stderr output is sent directly to terminal without buffering.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install system dependencies needed for compiling scientific packages (like Nilearn/Scipy)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy only dependency requirements first to leverage Docker layer caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy source code and project files into the container
COPY . .

# Expose FastAPI default port
EXPOSE 8000

# Health check to ensure API is ready to accept requests
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Start FastAPI application using Uvicorn
CMD ["uvicorn", "src.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
